# Viveris Carbone - Environment Variables Template
# Copy this file to .env and update with your values

# ======================
# Backend Configuration
# ======================

# Server port
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration (when you add a database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys (add as needed)
# SECRET_KEY=your-secret-key-here
# API_KEY=your-api-key-here

# ======================
# Frontend Configuration
# ======================

# API URL (backend endpoint)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ======================
# Docker Configuration
# ======================

# Docker Hub username for pushing images
DOCKER_USERNAME=your-dockerhub-username

# Image tags
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ======================
# VPS Deployment
# ======================

# VPS SSH configuration (for deployment)
# VPS_HOST=your-vps-ip-or-domain
# VPS_USER=your-vps-username
# VPS_SSH_KEY_PATH=~/.ssh/id_rsa

# Production URLs
# PROD_API_URL=https://api.yourdomain.com
# PROD_FRONTEND_URL=https://yourdomain.com
